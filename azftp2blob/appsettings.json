{
  // keys and values as in former azftp2blob.exe.config (appSettings)

  "FTP": "21",
  "FTPPASV": "59860",
  // Azure Storage Account
  "StorageAccount": "DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...",
  // Ftp server site, used to get its ipv4 ip, e.g. xxx.cloudapp.net (%computername% is expanded)
  "FtpServerHost": "localhost",
  "FtpServerHostPublic": "localhost",
  // if to overwrite file by default in STOR command (uploads) RFC959 says you should
  "FtpOverwriteFileOnSTOR": "True",
  // if to replace adjacent slashes in path to single, ie subdir1//subdir2//dubdir3 to subdir1/subdir2/dubdir3.
  // NTFS sees them as same while Blob Storage sees it as different
  "FtpReplaceSlashOnDELE": "True",
  // should we retrieve actual directory creation time when generating directory list;
  // this requires additional blob api call per each directory and may significantly slow down directory listing
  "FtpActualDirectoryCreationTime": "True",

  "LogPath": "log",
  "LoggingEnabled": "True",
  // Mode="Debug", use development storage; Mode="Live", use azure storage
  "Mode": "Live",
  // Max number of concurrent clients
  "MaxClients": "30",
  // Ftp Server Account Management - external text file
  "FtpAccount": "userlist.txt",
  "ConnectionEncoding": "UTF8",
  "MaxIdleSeconds": "60",
  "QueueNotification": "true",

  // maximum number of unsuccessfull login attempts from same login; negative value makes it unlimited. Default is 5
  "ftp.security.invalid-logon.max-attempts": "5",
  // period of time in which we count invalid logon attempts; default value is 60 seconds
  "ftp.security.invalid-logon.check-period-seconds": "60",
  // for how many seconds login is blocked when max invalid login attempts limit is exceeded; default value is 180 seconds
  "ftp.security.invalid-logon.block-period-seconds": "180",

  // should we store local time in logs; by default UTC is used
  "ftp.log.server-time": "true"
}
