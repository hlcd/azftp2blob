<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>azftp2blob</RootNamespace>
    <AssemblyName>azftp2blob</AssemblyName>
    <!-- assembly attributes are in Properties\AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AzureFtpServer\AzureFtpServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- ftp accounts, not in git -->
    <None Include="userlist.txt" Condition="Exists('userlist.txt')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
